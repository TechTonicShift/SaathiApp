// Saath MVP — Prisma schema (Supabase Postgres + PostGIS, free tier)
// Spatial columns use Unsupported() and are read/written via $queryRaw / $executeRaw.
// Companion SQL (CHECKs, GIST indexes, RLS, Realtime, pg_cron) lives in docs/SAATH_MVP_SPEC.md §2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum IntentType {
  DATING
  FRIENDSHIP
  NEW_IN_TOWN
}

enum Gender {
  WOMAN
  MAN
  NON_BINARY
  SELF_DESCRIBED
}

enum DietaryPreference {
  VEGETARIAN
  VEGAN
  PESCATARIAN
  HALAL
  KOSHER
  JAIN
  GLUTEN_FREE
  DAIRY_FREE
  NUT_FREE
}

enum AlcoholPreference {
  DRINKS
  SOMETIMES
  NEVER
}

enum AlcoholPolicy {
  ALCOHOL_FREE
  ALCOHOL_OPTIONAL
  ALCOHOL_CENTRIC
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum HostStatus {
  APPLIED
  APPROVED
  SUSPENDED
  REVOKED
}

enum EventFormat {
  FOOD_DRINK
  OUTDOOR
  ARTS_CRAFTS
  GAMES
  FITNESS
  LEARNING
  MUSIC
  OTHER
}

enum EventTag {
  FRIENDSHIP_FIRST
  OPEN_TO_DATING
  NEWCOMER_FRIENDLY
  BEGINNER_FRIENDLY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchingWindowStatus {
  NOT_OPEN
  OPEN
  CLOSED
}

enum BookingStatus {
  HELD // seat reserved, awaiting payment (holdExpiresAt)
  CONFIRMED
  WAITLISTED
  CANCELLED
  EXPIRED
}

enum AttendanceStatus {
  UNKNOWN
  CHECKED_IN
  NO_SHOW
}

enum CancellationSource {
  USER
  HOST
  SYSTEM
  MODERATOR
}

enum PaymentProvider {
  RAZORPAY
  FREE
}

enum RefundStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
}

enum InteractionChoice {
  FRIENDSHIP
  DATING
  EITHER
  PASS
}

enum MatchType {
  FRIENDSHIP
  DATING
}

enum MatchStatus {
  ACTIVE
  UNMATCHED
  BLOCKED
}

enum ChannelMessageKind {
  CHAT
  ANNOUNCEMENT
  SYSTEM
}

enum ReportCategory {
  HARASSMENT
  SAFETY_THREAT
  SEXUAL_MISCONDUCT
  INAPPROPRIATE_CONTENT
  FAKE_PROFILE
  UNDERAGE
  HOST_MISCONDUCT
  VENUE_UNSAFE
  OTHER
}

enum ReportSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReportStatus {
  OPEN
  TRIAGED
  ACTIONED
  DISMISSED
}

// ───────────────────────────── Identity ─────────────────────────────

model User {
  id                 String             @id @db.Uuid // = Supabase auth.users.id (lets RLS use auth.uid())
  email              String?            @unique
  phoneE164          String?            @unique // optional until SMS OTP is added post-launch
  dateOfBirth        DateTime?          @db.Date
  status             UserStatus         @default(ONBOARDING)
  role               UserRole           @default(MEMBER)
  verificationStatus VerificationStatus @default(NOT_STARTED)
  verificationGesture String?           @db.VarChar(40) // prompt the selfie must show, e.g. "peace sign, left hand"
  verificationSelfieKey String?         // private bucket; deleted after review
  verificationIdKey  String?            // private bucket; deleted after review
  verifiedAt         DateTime? @db.Timestamptz(3)
  expoPushToken      String?
  gender             Gender? // private: matching engine only
  datingPreferences  Gender[] // private: empty = open to all
  lastActiveAt       DateTime? @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)

  profile              Profile?
  intents              UserIntent[]
  catchments           UserCatchment[]
  host                 Host?
  bookings             EventBooking[]
  interactionsGiven    PostEventInteraction[] @relation("InteractionFrom")
  interactionsReceived PostEventInteraction[] @relation("InteractionTo")
  feedback             EventFeedback[]
  matchesAsA           Match[]                @relation("MatchUserA")
  matchesAsB           Match[]                @relation("MatchUserB")
  messages             Message[]
  channelMessages      EventChannelMessage[]
  reportsFiled         SafetyReport[]         @relation("ReportReporter")
  reportsAgainst       SafetyReport[]         @relation("ReportSubject")
  reportsAssigned      SafetyReport[]         @relation("ReportAssignee")
  blocksMade           UserBlock[]            @relation("Blocker")
  blocksReceived       UserBlock[]            @relation("Blocked")
  notifications        Notification[]

  @@index([status])
}

/// Private. Never serialized onto event, attendee, or public profile payloads.
model UserIntent {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @db.Uuid
  intent    IntentType
  createdAt DateTime   @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, intent])
}

model Profile {
  userId             String              @id @db.Uuid
  displayName        String              @db.VarChar(40)
  bio                String?             @db.VarChar(300)
  interests          String[]
  languages          String[] // ISO 639-1 codes
  budgetMinMinor     Int? // minor units in catchment currency
  budgetMaxMinor     Int?
  accessibilityNeeds String[]
  dietary            DietaryPreference[]
  alcohol            AlcoholPreference?
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos ProfilePhoto[]
}

model ProfilePhoto {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId        String           @db.Uuid
  storageKey       String // bucket object key; URLs are signed at read time
  position         Int              @db.SmallInt
  moderationStatus ModerationStatus @default(PENDING)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  profile Profile @relation(fields: [profileId], references: [userId], onDelete: Cascade)

  @@unique([profileId, position])
}

// ───────────────────────────── Geography ─────────────────────────────

/// A neighborhood micro-market. Any city in any country is just rows here.
model CatchmentArea {
  id          String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String                                       @unique
  name        String
  cityName    String
  countryCode String                                       @db.Char(2) // ISO 3166-1
  timezone    String // IANA, e.g. "Asia/Kolkata"
  currency    String                                       @db.Char(3) // ISO 4217
  emergencyNumber String                                   @db.VarChar(16) // dialed by the in-app emergency button
  boundary    Unsupported("geometry(MultiPolygon, 4326)")?
  centroid    Unsupported("geography(Point, 4326)")?
  isActive    Boolean                                      @default(true)
  createdAt   DateTime                                     @default(now()) @db.Timestamptz(3)

  users  UserCatchment[]
  venues Venue[]
  events Event[]

  @@index([countryCode, cityName])
}

model UserCatchment {
  userId      String   @db.Uuid
  catchmentId String   @db.Uuid
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  catchment CatchmentArea @relation(fields: [catchmentId], references: [id], onDelete: Cascade)

  @@id([userId, catchmentId])
  @@index([catchmentId])
}

model Venue {
  id              String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catchmentId     String                                 @db.Uuid
  createdByHostId String?                                @db.Uuid
  name            String
  publicAreaLabel String // shown pre-booking, e.g. "Near Central Park"
  addressLine     String // revealed to CONFIRMED attendees only
  location        Unsupported("geography(Point, 4326)")?
  accessibility   String[]
  isVerified      Boolean                                @default(false)
  createdAt       DateTime                               @default(now()) @db.Timestamptz(3)

  catchment CatchmentArea @relation(fields: [catchmentId], references: [id])
  createdBy Host?         @relation(fields: [createdByHostId], references: [id], onDelete: SetNull)
  events    Event[]

  @@index([catchmentId])
}

// ───────────────────────────── Events ─────────────────────────────

model Host {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String     @unique @db.Uuid
  status      HostStatus @default(APPLIED)
  bio         String?    @db.VarChar(500)
  ratingSum   Int        @default(0)
  ratingCount Int        @default(0)
  payoutRef   String? // MVP: manual payouts; later Razorpay Route / Stripe Connect id
  approvedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  venues Venue[]
}

model Event {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hostId             String               @db.Uuid
  venueId            String               @db.Uuid
  catchmentId        String               @db.Uuid
  title              String               @db.VarChar(80)
  description        String               @db.VarChar(2000)
  coverImageKey      String?
  format             EventFormat
  tags               EventTag[]
  languages          String[]
  dietaryOptions     DietaryPreference[]
  alcoholPolicy      AlcoholPolicy
  startsAt           DateTime @db.Timestamptz(3)
  endsAt             DateTime @db.Timestamptz(3)
  minAttendees       Int                  @default(4) @db.SmallInt // CHECK 4..8 in SQL
  maxAttendees       Int                  @default(8) @db.SmallInt
  bookedCount        Int                  @default(0) @db.SmallInt // HELD + CONFIRMED
  costMinor          Int // venue/materials, passed through
  platformFeeMinor   Int
  currency           String               @db.Char(3)
  status             EventStatus          @default(DRAFT)
  cancelledReason    String?
  checkInCode        String               @default(dbgenerated("lpad((floor(random() * 10000))::int::text, 4, '0')")) @db.Char(4) // attendee self check-in code
  matchingStatus     MatchingWindowStatus @default(NOT_OPEN)
  matchingOpensAt    DateTime? @db.Timestamptz(3)
  matchingClosesAt   DateTime? @db.Timestamptz(3)
  channelPurgedAt    DateTime? @db.Timestamptz(3)
  createdAt          DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @db.Timestamptz(3)

  host            Host                   @relation(fields: [hostId], references: [id])
  venue           Venue                  @relation(fields: [venueId], references: [id])
  catchment       CatchmentArea          @relation(fields: [catchmentId], references: [id])
  bookings        EventBooking[]
  interactions    PostEventInteraction[]
  feedback        EventFeedback[]
  matches         Match[]
  channelMessages EventChannelMessage[]
  reports         SafetyReport[]

  @@index([catchmentId, status, startsAt])
  @@index([hostId, startsAt])
  @@index([status, endsAt]) // job sweeps
}

model EventBooking {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId            String              @db.Uuid
  userId             String              @db.Uuid
  status             BookingStatus
  attendance         AttendanceStatus    @default(UNKNOWN)
  checkedInAt        DateTime? @db.Timestamptz(3)
  waitlistPosition   Int?
  holdExpiresAt      DateTime? @db.Timestamptz(3)
  amountMinor        Int
  platformFeeMinor   Int
  currency           String              @db.Char(3)
  provider           PaymentProvider
  providerOrderId    String?             @unique // Razorpay payment-link id
  providerPaymentId  String?             @unique
  idempotencyKey     String              @unique
  refundStatus       RefundStatus        @default(NONE)
  refundAmountMinor  Int?
  providerRefundId   String?             @unique
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancellationSource CancellationSource?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([userId, status])
  @@index([status, holdExpiresAt])
}

// ───────────────────────────── Matching ─────────────────────────────

/// One row per (event, from, to). Immutable once written; visible only to fromUser.
model PostEventInteraction {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId    String            @db.Uuid
  fromUserId String            @db.Uuid
  toUserId   String            @db.Uuid
  choice     InteractionChoice
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fromUser User  @relation("InteractionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("InteractionTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([eventId, fromUserId, toUserId])
  @@index([eventId, toUserId])
}

model EventFeedback {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId           String   @db.Uuid
  userId            String   @db.Uuid
  hostRating        Int      @db.SmallInt // 1..5
  venueSafetyRating Int      @db.SmallInt // 1..5
  feltSafe          Boolean
  comment           String?  @db.VarChar(1000)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

/// One row per unordered pair (userAId < userBId), across all events.
model Match {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId       String      @db.Uuid // event where the match first formed
  userAId       String      @db.Uuid
  userBId       String      @db.Uuid
  type          MatchType
  status        MatchStatus @default(ACTIVE)
  endedById     String?     @db.Uuid
  endedAt       DateTime? @db.Timestamptz(3)
  lastMessageAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  event    Event          @relation(fields: [eventId], references: [id])
  userA    User           @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User           @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]
  reports  SafetyReport[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Message {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId          String           @db.Uuid
  senderId         String           @db.Uuid
  clientId         String // client-generated id for idempotent sends
  body             String           @db.VarChar(2000)
  moderationStatus ModerationStatus @default(APPROVED)
  readAt           DateTime? @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)

  match  Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([matchId, createdAt])
}

/// Temporary logistics channel; purged by a scheduled job after the event.
model EventChannelMessage {
  id        String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String             @db.Uuid
  senderId  String?            @db.Uuid // null for SYSTEM
  kind      ChannelMessageKind @default(CHAT)
  body      String             @db.VarChar(1000)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender User? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

// ───────────────────────────── Safety ─────────────────────────────

model SafetyReport {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId       String         @db.Uuid
  subjectUserId    String?        @db.Uuid
  eventId          String?        @db.Uuid
  matchId          String?        @db.Uuid
  category         ReportCategory
  severity         ReportSeverity
  status           ReportStatus   @default(OPEN)
  isEmergency      Boolean        @default(false)
  description      String         @db.VarChar(4000)
  evidenceKeys     String[]
  assignedToId     String?        @db.Uuid
  resolutionNote   String?
  resolvedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(3)

  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id])
  subject    User?  @relation("ReportSubject", fields: [subjectUserId], references: [id])
  assignedTo User?  @relation("ReportAssignee", fields: [assignedToId], references: [id])
  event      Event? @relation(fields: [eventId], references: [id])
  match      Match? @relation(fields: [matchId], references: [id])

  @@index([status, severity, createdAt])
  @@index([subjectUserId])
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  reason    String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// ───────────────────────────── Notifications ─────────────────────────────

/// Outbox drained every minute by the send-push Edge Function (Expo Push is free).
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(80)
  body      String    @db.VarChar(200)
  data      Json?
  sentAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sentAt, createdAt])
}
